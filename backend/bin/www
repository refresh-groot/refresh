#!/usr/bin/env node

/**
 * 환경 변수 설정 로드
 * .env 파일로부터 보안 설정값 관리
 */
require('dotenv').config(); // 최상단에서 환경 변수 우선 정의

const app = require('../app'); // app.js 애플리케이션 설정 로드
const http = require('http'); // 노드 기본 HTTP 모듈 로드

/**
 * 포트 설정
 * 환경 변수 미지정 시 기본값 8080 사용
 */
const port = process.env.PORT || '8080';
app.set('port', port); // 애플리케이션 내부 설정에 포트 등록



/**
 * HTTP 서버 생성 및 가동
 * app.js 로직 기반 서버 객체 생성 및 요청 대기 시작
 */
const server = http.createServer(app); // 익스프레스 로직 포함 서버 생성

server.listen(port, () => {
  console.log(`SmartPlant 서버가 ${port}번 포트에서 가동 중입니다.`);
});